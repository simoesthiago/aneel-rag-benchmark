# Token de acesso ao HuggingFace Hub
# Gere em: https://huggingface.co/settings/tokens
HF_TOKEN=seu_token_aqui

# Nome do repositório de dataset no HuggingFace
# Formato: seu-usuario/nome-do-dataset
HF_DATASET_REPO=seu-usuario/aneel-corpus

# API key para o LLM (OpenAI ou outro)
LLM_API_KEY=sua_chave_aqui

# Modelo de LLM a usar
LLM_MODEL=gpt-4o-mini

# (Opcional) Proxy HTTP em região brasileira para baixar do cedoc/.
# Necessário em Colab/GitHub Actions (IPs de datacenter estrangeiros são bloqueados).
# Em Mac/rede residencial brasileira, deixe em branco — curl_cffi basta.
# Ver proxies/aneel-proxy-fly/README.md para deploy no Fly.io.
# ANEEL_PROXY_URL=https://aneel-proxy-br.fly.dev
