# Token de acesso ao HuggingFace Hub
HF_TOKEN=seu_token_aqui

# Nome do repositório de dataset no HuggingFace
HF_DATASET_REPO=seu-usuario/aneel-corpus

# API key para o LLM (OpenAI ou outro)
LLM_API_KEY=sua_chave_aqui

# API key para o Cohere
COHERE_API_KEY=sua_chave_aqui

# Modelo de LLM
LLM_MODEL=gpt-5.4-mini
LLM_REQUEST_TIMEOUT_SECONDS=60
