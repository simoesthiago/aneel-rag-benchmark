# Token de acesso ao HuggingFace Hub
# Gere em: https://huggingface.co/settings/tokens
HF_TOKEN=seu_token_aqui

# Nome do repositório de dataset no HuggingFace
# Formato: seu-usuario/nome-do-dataset
HF_DATASET_REPO=seu-usuario/aneel-corpus

# API key para o LLM (OpenAI ou outro)
LLM_API_KEY=sua_chave_aqui

# Modelo de LLM a usar
LLM_MODEL=gpt-4o-mini

# Cloudflare Worker para cedoc/ (obrigatório em Colab/GitHub Actions).
# O cedoc/ bloqueia IPs de datacenter — o Worker usa Service Placement para
# forçar edge brasileira. Ver workers/aneel-proxy/README.md.
# ANEEL_PROXY_URL=https://aneel-proxy.<seu-usuario>.workers.dev

# Cloudflare Worker para GitLab da ANEEL (obrigatório em Colab/GitHub Actions).
# O git.aneel.gov.br também bloqueia datacenters com timeout. Mesmo mecanismo.
# Ver workers/aneel-gitlab-proxy/README.md.
# ANEEL_GITLAB_PROXY_URL=https://aneel-gitlab-proxy.<seu-usuario>.workers.dev
