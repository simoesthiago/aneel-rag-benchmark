# Token de acesso ao HuggingFace Hub
# Gere em: https://huggingface.co/settings/tokens
HF_TOKEN=seu_token_aqui

# Nome do repositório de dataset no HuggingFace
# Formato: seu-usuario/nome-do-dataset
HF_DATASET_REPO=seu-usuario/aneel-corpus

# API key para o LLM (OpenAI ou outro)
LLM_API_KEY=sua_chave_aqui

# Modelo de LLM a usar
LLM_MODEL=gpt-4o-mini

# URL do Cloudflare Worker que faz proxy do cedoc/ (passa pelo Cloudflare
# Bot Management que bloqueia IPs de data center). Ver DECISIONS.md e
# workers/aneel-proxy/README.md para detalhes do deploy.
# Formato: https://aneel-proxy.<seu-username>.workers.dev
ANEEL_PROXY_URL=https://aneel-proxy.seu-username.workers.dev
